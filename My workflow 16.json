    {
      "parameters": {
        "jsCode": "// Combine the original message data with the fetched contact's phone number\nconst messageData = $('Valid Signature AND Inbound?').item.json;\nconst contactData = $input.first().json;\n\nconst rawPhone = contactData.phoneNumber || '';\nconst digitsOnly = String(rawPhone).replace(/[^0-9]/g, '');\nconst phone_e164 = digitsOnly ? '+' + digitsOnly : '';\n\nreturn [{\n  json: {\n    conversation_id: messageData.conversationId,\n    customer_phone_e164: phone_e164,\n    contact_name: contactData.name || '',\n    message_body: messageData.body || '',\n    message_type: messageData.messageType || '',\n    channel_source: 'whatsapp',\n    started_at: new Date().toISOString(),\n    status: 'active'\n  }\n}];"
      },
