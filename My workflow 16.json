      "parameters": {
        "jsCode": "// Verify HMAC-SHA256 signature from Voxa (X-Voxa-Signature header)\n// If verification fails, we stop processing (return empty to halt this branch)\nconst crypto = require('crypto');\n\nconst webhookSecret = 'whsec_krEvmzIEdH8tM2UdaCvokRnLidIw6KrGS36z7qLYk6I';\nconst receivedSignature = $input.first().json.headers['x-voxa-signature'] || '';\nconst rawBody = JSON.stringify($input.first().json.body);\n\nconst computed = crypto.createHmac('sha256', webhookSecret).update(rawBody, 'utf8').digest('hex');\n\nconst isValid = computed === receivedSignature;\n\nreturn [{\n  json: {\n    ...$input.first().json.body,\n    _signatureValid: isValid\n  }\n}];"
      },
      "id": "a0307bcc-f14e-4ad5-bc1b-b045700d2f1e",
